# Only deploy/.env is read by Docker Compose. Never commit the real file.
LUMORA_BIND_HOST=0.0.0.0

MYSQL_IMAGE=mysql:8.0
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lumora_user
MYSQL_USER=lumora
MYSQL_PASSWORD=change-me
LUMORA_USER_DATABASE=lumora_user
LUMORA_BILLING_DATABASE=lumora_billing
LUMORA_MODEL_CATALOG_DATABASE=lumora_model_catalog

REDIS_IMAGE=redis:7-alpine
REDIS_HOST_PORT=6379
REDIS_PASSWORD=change-me

RABBITMQ_IMAGE=rabbitmq:3.8-management
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_DEFAULT_USER=lumora
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=/lumora

NACOS_IMAGE=nacos/nacos-server:v3.0.3
NACOS_CONSOLE_HOST_PORT=8080
NACOS_SERVER_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=128m
NACOS_AUTH_TOKEN=replace-with-a-base64-secret-at-least-32-bytes-long
NACOS_AUTH_IDENTITY_KEY=replace-with-server-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-server-identity-value
NACOS_ADMIN_PASSWORD=change-me

SENTINEL_VERSION=1.8.9
SENTINEL_HOST_PORT=8858
SENTINEL_USERNAME=sentinel
SENTINEL_PASSWORD=change-me
