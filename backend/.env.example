SPRING_PROFILES_ACTIVE=dev

LUMORA_JWT_SECRET=replace-with-at-least-32-random-characters
LUMORA_INTERNAL_TOKEN=replace-with-a-random-internal-service-token
LUMORA_COOKIE_SECURE=false

LUMORA_NACOS_ADDR=192.168.100.132:8848
LUMORA_NACOS_USERNAME=nacos
LUMORA_NACOS_PASSWORD=change-me
LUMORA_SENTINEL_DASHBOARD=192.168.100.132:8858

LUMORA_MYSQL_HOST=192.168.100.132
LUMORA_MYSQL_PORT=3307
LUMORA_MYSQL_USERNAME=lumora
LUMORA_MYSQL_PASSWORD=change-me
LUMORA_USER_DATABASE=lumora_user
LUMORA_BILLING_DATABASE=lumora_billing
LUMORA_MODEL_CATALOG_DATABASE=lumora_model_catalog

LUMORA_REDIS_HOST=192.168.100.132
LUMORA_REDIS_PORT=6379
LUMORA_REDIS_PASSWORD=change-me

LUMORA_RABBITMQ_HOST=192.168.100.132
LUMORA_RABBITMQ_PORT=5672
LUMORA_RABBITMQ_VHOST=/lumora
LUMORA_RABBITMQ_USERNAME=lumora
LUMORA_RABBITMQ_PASSWORD=change-me

# Stable 32-byte Base64 key used only by Model Catalog to encrypt provider credentials.
# Generate once, back it up securely, and never change it without a key migration.
LUMORA_CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
LUMORA_CREDENTIAL_KEY_VERSION=1

# Optional legacy fallback for providers created before encrypted credential management.
LUMORA_OPENAI_API_KEY=replace-with-provider-api-key
